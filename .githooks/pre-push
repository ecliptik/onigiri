#!/usr/bin/env bash
# Blocks a push that carries personal information — see
# scripts/check-personal-data.sh. Installed by scripts/install-hooks.sh.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # a deletion sends nothing
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"            # a new branch: what no remote has
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  "$(git rev-parse --show-toplevel)/scripts/check-personal-data.sh" $range || status=1
done
exit $status
